# Environment Variables Template
# Copy this file to .dev.vars for local Cloudflare Workers dev (never commit secrets)
#   cp .env.example .dev.vars
#
# NOT: Veritabanı Cloudflare D1 binding (`DB`) üzerinden bağlanır.
# DATABASE_URL / PostgreSQL artık kullanılmıyor.

# Optional: Application Settings
# NODE_ENV="production"

# Optional: Analytics & Tracking
# Disable view tracking in development
# DISABLE_ANALYTICS="true"
